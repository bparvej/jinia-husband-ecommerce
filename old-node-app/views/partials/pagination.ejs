<% if (pagination.totalPages > 1) { %>
    <div class="pagination">
        <% if (pagination.hasPrev) { %>
            <a href="?page=<%= pagination.page - 1 %>" 
               class="page-btn" 
               hx-get="<%= baseUrl %>?page=<%= pagination.page - 1 %>&_partial=1" 
               hx-target="<%= targetContainer %>">← Prev</a>
        <% } %>
        
        <% pageNumbers.forEach(num => { %>
            <a href="?page=<%= num %>" 
               class="page-btn <%= num === pagination.page ? 'active' : '' %>"
               hx-get="<%= baseUrl %>?page=<%= num %>&_partial=1" 
               hx-target="<%= targetContainer %>"><%= num %></a>
        <% }) %>
        
        <% if (pagination.hasNext) { %>
            <a href="?page=<%= pagination.page + 1 %>" 
               class="page-btn" 
               hx-get="<%= baseUrl %>?page=<%= pagination.page + 1 %>&_partial=1" 
               hx-target="<%= targetContainer %>">Next →</a>
        <% } %>
    </div>
<% } %>
