<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Customer</th>
                <th>Rating</th>
                <th>Comment</th>
                <th>Date</th>
                <th>Status</th>
                <th class="text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (reviews.length > 0) { %>
                <% reviews.forEach(review => { %>
                <tr>
                    <td>
                        <div class="product-cell">
                            <span class="product-cell-name"><%= review.Product ? review.Product.name : 'Unknown Product' %></span>
                        </div>
                    </td>
                    <td>
                        <div class="user-details">
                            <span class="user-name"><%= review.User ? review.User.name : 'Anonymous' %></span>
                        </div>
                    </td>
                    <td>
                        <div class="rating-stars" style="color: var(--admin-accent); display: flex; gap: 2px;">
                            <% for(let i=1; i<=5; i++) { %>
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="<%= i <= review.rating ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                            <% } %>
                        </div>
                    </td>
                    <td style="max-width: 300px;">
                        <p class="text-sm text-muted" style="white-space: normal;"><%= review.comment %></p>
                    </td>
                    <td class="text-muted text-sm">
                        <%= new Date(review.created_at).toLocaleDateString('en-GB') %>
                    </td>
                    <td>
                        <div id="status-<%= review.id %>">
                            <span class="status-badge <%= review.is_approved ? 'active' : 'pending' %>">
                                <%= review.is_approved ? 'Approved' : 'Pending' %>
                            </span>
                        </div>
                    </td>
                    <td class="text-right">
                        <div class="action-btns" style="justify-content: flex-end;">
                            <% if (!review.is_approved) { %>
                                <button class="action-btn-sm save" title="Approve"
                                    hx-put="/admin/reviews/<%= review.id %>/approve"
                                    hx-target="#status-<%= review.id %>"
                                    hx-swap="innerHTML"
                                    hx-confirm="Approve this review?">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                </button>
                            <% } %>
                            <button class="action-btn-sm delete" title="Delete"
                                hx-delete="/admin/reviews/<%= review.id %>?_method=DELETE"
                                hx-target="closest tr" hx-swap="outerHTML swap:0.3s"
                                hx-confirm="Delete this review?">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </div>
                    </td>
                </tr>
                <% }) %>
            <% } else { %>
                <tr><td colspan="7" class="text-center text-muted">No reviews found</td></tr>
            <% } %>
        </tbody>
    </table>
</div>

<%- include('../../../partials/pagination', { baseUrl: '/admin/reviews', targetContainer: '#review-table-container' }) %>
