<header class="admin-topbar">
    <div class="topbar-left">
        <button class="topbar-toggle" @click="sidebarOpen = !sidebarOpen" aria-label="Toggle sidebar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>
        <h1 class="topbar-title"><%= typeof title !== 'undefined' ? title.replace(' — HomeI Admin', '') : 'Dashboard' %></h1>
    </div>

    <div class="topbar-right">
        <div class="topbar-search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="M21 21l-4.35-4.35"></path>
            </svg>
            <input type="text" placeholder="Search..." aria-label="Search">
        </div>

        <div class="topbar-actions" x-data="{ userMenu: false }">
            <button class="topbar-user-btn" @click="userMenu = !userMenu" @click.outside="userMenu = false">
                <div class="topbar-avatar">
                    <%= typeof currentUser !== 'undefined' && currentUser ? currentUser.name.charAt(0).toUpperCase() : 'A' %>
                </div>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </button>

            <div class="topbar-dropdown" x-show="userMenu" x-transition x-cloak>
                <div class="dropdown-header">
                    <strong><%= typeof currentUser !== 'undefined' && currentUser ? currentUser.name : 'Admin' %></strong>
                    <span><%= typeof currentUser !== 'undefined' && currentUser ? currentUser.email : '' %></span>
                </div>
                <div class="dropdown-divider"></div>
                <a href="/" class="dropdown-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                    View Store
                </a>
                <a href="/logout" class="dropdown-item text-danger">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    Logout
                </a>
            </div>
        </div>
    </div>
</header>
