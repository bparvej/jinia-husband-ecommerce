# ==========================================
# cPanel Environment Configuration Guide
# ==========================================
# 1. Rename this file to exactly `.env` (with the dot) in your cPanel File Manager.
# 2. Fill in the values below.

# --- Application Settings ---
NODE_ENV=production
# PORT is automatically set by cPanel's Node App Manager, but you can leave this here.
PORT=3000
# Change this to a secure random string!
SESSION_SECRET=your_secure_random_string_here

# --- Database Settings (cPanel MySQL) ---
# Usually 'localhost' or '127.0.0.1' in cPanel
DB_HOST=127.0.0.1
DB_PORT=3306

# IMPORTANT: cPanel prefixes your database name and user with your cPanel username!
# Example: If your cPanel username is 'parvej', and you made a db 'homei', the name is 'parvej_homei'
DB_NAME=yourcpanelusername_dbname
DB_USER=yourcpanelusername_dbuser
DB_PASSWORD=your_mysql_database_password
